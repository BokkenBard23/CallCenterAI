# ── Call Center AI Backend ─────────────────────────────────
# Copy this file to .env and fill in the values

# ── Application ──
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Paths ──
TRANSCRIB_DIR=../Transcrib
SMARTLOGGER_DIR=../Transcrib/smartlogger
DATA_DIR=../data

# ── LLM Providers ──
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# YandexGPT
YANDEXGPT_API_KEY=your-yandexgpt-api-key-here
YANDEXGPT_FOLDER_ID=your-folder-id-here
YANDEXGPT_MODEL=yandexgpt-lite

# GigaChat
GIGACHAT_AUTH_KEY=your-gigachat-auth-key-here
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Beeline AI (OpenAI-compatible API)
BEELINE_API_KEY=
BEELINE_DEFAULT_MODEL=glm-5.1

# ── Upload limits ──
MAX_UPLOAD_SIZE_MB=50
