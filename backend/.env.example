# ── Call Center AI Backend ─────────────────────────────────
# Copy this file to .env and fill in the values

# ── Application ──
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Paths ──
TRANSCRIB_DIR=../Transcrib
SMARTLOGGER_DIR=../Transcrib/smartlogger
DATA_DIR=../data

# ── LLM Providers ──
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# YandexGPT
YANDEXGPT_API_KEY=your-yandexgpt-api-key-here
YANDEXGPT_FOLDER_ID=your-folder-id-here
YANDEXGPT_MODEL=yandexgpt-lite

# GigaChat
GIGACHAT_AUTH_KEY=your-gigachat-auth-key-here
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Beeline AI (OpenAI-compatible API)
# Model family codes per https://docs.ai.beeline.ru/quickstart/models/
#   glm-xlarge          — GLM-5.2, serious tasks (summary, quality, dict_analysis)
#   glm-xlarge-fast     — GLM-5.2 fast, short classifications
#   qwen-medium         — Qwen3.5-35B stable
#   qwen-medium-preview — Qwen3.6-35B preview
BEELINE_API_KEY=
BEELINE_DEFAULT_MODEL=glm-xlarge

# ── Embeddings: provider selection (semantic search offline fallback) ──
# EMBEDDING_PROVIDER:
#   frida — always use the FRIDA embeddings API (Beeline AI, needs network)
#   local — always use the offline TF-IDF provider (numpy + razdel, no network)
#   auto  — (default) probe FRIDA once at startup; if unreachable, fall back
#           to the local TF-IDF provider automatically
# The ACTIVE provider is reported by GET /api/health (field "embedding")
# and GET /api/embeddings/status (field "embedding_provider").
EMBEDDING_PROVIDER=auto
# Timeout (seconds) for the one-shot FRIDA availability probe in auto mode.
EMBEDDING_PROBE_TIMEOUT=5.0

# ── Upload limits ──
MAX_UPLOAD_SIZE_MB=50

# ── Session limits ──
# Maximum number of sessions before TTL cleanup triggers.
# Dev/demo default: 100.  Set 1000+ for production.
MAX_SESSIONS=100

# SQLite page cache size in kilobytes (per connection).
# 524288 = 512 MB (handles multi-analyst workload with large dictionaries)
# 262144 = 256 MB (lighter memory footprint)
# 65536  = 64 MB  (dev only, may thrash with large dictionaries)
SQLITE_CACHE_SIZE_KB=524288

# ── PII Masking (ID-4: Presidio + spaCy NER for 152-ФЗ compliance) ──
# When true, ALL uploaded RTF dialogs are masked BEFORE session storage.
# Upload endpoint returns HTTP 503 if PII masking is enabled but unavailable
# (spaCy model missing or circuit breaker open).
#
# Prerequisites (mandatory when PII_MASKING_ENABLED=true):
#   1. spaCy installed:        pip install "spacy>=3.8,<3.9"
#   2. Russian NER model:      python -m spacy download ru_core_news_sm
#   3. Verify installation:
#      python -c "import ru_core_news_sm; nlp = ru_core_news_sm.load(); print('OK')"
#
# Verify service is ready at runtime:
#   curl http://localhost:8000/api/health | python -m json.tool
#   → pii_masking: {"enabled": true, "available": true, ...}
#
# If you cannot install the spaCy model, set PII_MASKING_ENABLED=false
# (NOT recommended for production — non-compliant with 152-ФЗ).
PII_MASKING_ENABLED=true
PII_MASKING_LANGUAGE=ru
PII_MASKING_MIN_SCORE=0.5
PII_MASKING_CIRCUIT_RESET_SECONDS=60.0
PII_MASKING_FAILURE_THRESHOLD=3
