{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "pipeline-orchestrator",
  "agent": {
    "pipeline-orchestrator": {
      "description": "Единая точка входа OpenCode Pipeline: автоматически запускает stage agents, проверяет артефакты и ведёт pipeline-state без ручного переключения режимов.",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git status*": "allow",
          "npx --yes @beeline/yellowbe-opencode-pipeline@latest check-update*": "allow",
          "npx --yes @beeline/yellowbe-opencode-pipeline@latest safe-update*": "allow",
          "*yellowbe-opencode-pipeline.mjs check-update*": "allow",
          "*yellowbe-opencode-pipeline.mjs safe-update*": "allow",
          "npm run*": "allow",
          "npm install*": "allow",
          "npx tsc*": "allow",
          "npx vitest*": "allow",
          "git push*": "deny",
          "rm *": "deny"
        },
        "task": {
          "*": "deny",
          "request-analyst": "allow",
          "request-analyst-product": "allow",
          "request-analyst-marketing": "allow",
          "project-setup": "allow",
          "designer": "allow",
          "ui-coder": "allow",
          "ui-tester": "allow",
          "coder": "allow",
          "reviewer": "allow",
          "tester": "allow",
          "mcp-researcher": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "chrome-devtools-mcp_*": "allow",
        "chrome_devtools_mcp_*": "allow"
      }
    },
    "request-analyst": {
      "description": "Лёгкий входной режим: выбирает трек `product` или `marketing`, обновляет pipeline-state и маршрутизирует задачу дальше.",
