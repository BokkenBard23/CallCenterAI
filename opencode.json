  "mcp": {
    "pixso-remote-mcp": {
      "type": "remote",
      "url": "https://example.com/api/mcp/mcp",
      "enabled": true,
      "headers": {
        "Token": "{env:PIXSO_TOKEN}"
      },
      "description": "Pixso Remote MCP — дизайн-система Pixso (токен из переменной окружения)"
    },
    "rag-knowledge": {
      "type": "remote",
      "url": "http://127.0.0.1:8765/mcp",
      "enabled": true,
      "description": "Beeline AI RAG Knowledge Base — поиск по базе знаний (permanent-api-crq411646), LLM glm-xlarge. HTTP сервер на порту 8765."
    },
    "prod-design-system-http": {
      "type": "remote",
      "url": "https://example.com/sse",
      "enabled": true
    },
    "chrome-devtools-mcp": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
      "description": "Chrome DevTools MCP — browser automation, screenshots, performance, network, debugging. Official Google package. Requires Chrome stable with --remote-debugging-port=9222."
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "description": "Context7 MCP — документация и код из Context7. API key из env CONTEXT7_API_KEY. Без ключа работает с rate-limit, с ключом — выше лимиты."
    },
    "fetch": {
      "type": "local",
      "command": ["npx", "--yes", "@modelcontextprotocol/server-fetch"],
      "enabled": false,
      "description": "Fetch MCP — HTTP requests, web scraping. DISABLED: @modelcontextprotocol/server-fetch не существует на npm (404). Альтернативы: использовать built-in webfetch или написать кастомный скрипт. НЕ заменять на mcp-server-fetch (0.0.2) — это подозрительный canary-пакет."
    },
    "git": {
      "type": "local",
      "command": ["uvx", "mcp-server-git", "--repository", "."],
      "enabled": true,
      "description": "Git MCP — git history, blame, diff. Использует uvx (uv 0.11.24+). uv установлен и подтверждён."
    },
    "memory": {
      "type": "local",
      "command": ["cmd", "/c", "node_modules\\.bin\\mcp-server-memory.cmd"],
      "environment": { },
      "enabled": true,
      "description": "Memory MCP — persistent key-value memory across sessions"
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["node", "node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js"],
      "environment": { },
      "enabled": true,
      "description": "Sequential Thinking MCP — structured step-by-step reasoning. Official @modelcontextprotocol package v2025.12.18."
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-filesystem", "."],
      "environment": { },
      "enabled": true,
      "description": "Filesystem MCP — read/write files"
    },
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true,
      "environment": { },
      "description": "Microsoft Learn MCP — официальная документация. NOTE: McAfee может блокировать — если 407, нужен VPN"
    },
    "gitlab-mcp": {
      "type": "remote",
      "url": "https://mcp.example.com/mcp",
      "enabled": true,
      "description": "GitLab MCP — MR, issues, pipelines, код-серч (токен из переменной окружения GITLAB_TOKEN)",
      "headers": {
        "Authorization": "Bearer {env:GITLAB_TOKEN}"
      }
    },
    "atlassian-mcp": {
      "type": "remote",
      "url": "https://mcp.example.com/mcp",
      "enabled": true,
      "description": "Atlassian MCP — Jira + Confluence (токен из переменной окружения ATLASSIAN_TOKEN)",
      "headers": {
        "Authorization": "Bearer {env:ATLASSIAN_TOKEN}"
      }
    },
    "figma": {
      "type": "local",
      "command": ["cmd", "/c", "node_modules\\.bin\\figma-developer-mcp.cmd", "--figma-api-key={env:FIGMA_API_KEY}", "--stdio"],
      "environment": { "FRAMELINK_TELEMETRY": "off" },
      "enabled": true,
      "description": "Figma MCP — чтение Figma файлов, слоёв, компонентов, design tokens (ключ из переменной окружения FIGMA_API_KEY)"
    },
    "storybook": {
      "type": "local",
      "command": ["npx", "-y", "storybook-mcp@latest"],
      "environment": { "STORYBOOK_URL": "http://localhost:6006/index.json" },
      "enabled": false,
      "description": "Storybook MCP — нужен запущенный Storybook на localhost:6006"
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "postgresql://{env:POSTGRES_USER}:{env:POSTGRES_PASS}@localhost:5432/mydb"],
      "environment": { },
      "enabled": true,
      "description": "PostgreSQL MCP — read-only SQL queries, schema inspection (credentials из POSTGRES_USER и POSTGRES_PASS)"
    },
    "slack": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-slack"],
      "environment": {
        "SLACK_BOT_TOKEN": "{env:SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "{env:SLACK_TEAM_ID}"
      },
      "enabled": false,
      "description": "Slack MCP — read/send messages, search channels. DISABLED: пакет @modelcontextprotocol/server-slack устарел (deprecated). Токен из переменной окружения SLACK_BOT_TOKEN."
    },
    "sentry": {
      "type": "local",
      "command": ["npx", "-y", "@sentry/mcp-server"],
      "environment": { "SENTRY_AUTH_TOKEN": "{env:SENTRY_AUTH_TOKEN}" },
      "enabled": false,
      "description": "Sentry MCP — ОФИЦИАЛЬНЫЙ @sentry/mcp-server (v0.36.0). Error tracking, issues, releases. ЗАМЕНА: был @supernova123/sentry-mcp-server (third-party). Токен из env SENTRY_AUTH_TOKEN."
    },
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server", "--transport", "stdio"],
      "environment": { "BRAVE_API_KEY": "{env:BRAVE_API_KEY}" },
      "enabled": true,
      "description": "Официальный Brave Search MCP v2 — 8 инструментов: web/local/video/image/news search, summarizer, LLM context. Заменяет устаревший fork. Бесплатно 2000 запросов/мес. Получи ключ: https://brave.com/search/api/"
    },
    "playwright-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "environment": { },
      "enabled": true,
      "description": "Official Microsoft Playwright MCP — 143 device presets, DOM interaction, screenshots, JS execution, test codegen. E2E тестирование 5 страниц CCAI. Автоматически устанавливает браузеры."
    },
    "local-faiss-mcp": {
      "type": "local",
      "command": ["uvx", "local-faiss-mcp", "--stdio"],
      "enabled": true,
      "description": "Local FAISS vector store as MCP server — semantic search, document ingestion. Python-пакет, использует uvx (uv 0.11.24+)."
    },
    "openapi-schema-explorer": {
      "type": "local",
      "command": ["npx", "-y", "mcp-openapi-schema-explorer@latest", "http://localhost:8000/openapi.json", "--output-format", "json"],
      "environment": { },
      "enabled": true,
      "description": "MCP OpenAPI Schema Explorer — подключён к FastAPI backend (auto-generated spec). Для работы нужен запущенный backend: cd backend && uvicorn app.main:app --port 8000. Если backend не запущен — MCP будет unavailable, но OpenCode не упадёт."
    },
    "ux-mcp-server": {
      "type": "local",
      "command": ["cmd", "/c", "node_modules\\.bin\\ux-mcp-server.cmd"],
      "environment": { },
      "enabled": true,
      "description": "UX MCP Server — 28 UX resources (WCAG, Nielsen, UI patterns, a11y, dark patterns) + 23 analysis tools"
    },
    "vuda": {
      "type": "local",
      "command": ["cmd", "/c", "node_modules\\.bin\\vuda.cmd"],
      "environment": { },
      "enabled": true,
      "description": "VUDA — Visual UI Debug Agent: 30 Playwright tools for screenshots, visual diff, workflow testing, Core Web Vitals"
    },
    "tactual": {
      "type": "local",
      "command": ["npx", "--yes", "tactual-mcp"],
      "enabled": true,
      "description": "Tactual — Screen-reader navigation cost analyzer: 5-dim scoring, NVDA/JAWS/VoiceOver/TalkBack profiles. Включён: исправлена команда (npx --yes tactual-mcp) для обхода локальной JSON Schema ошибки."
    },
    "ui-ux-pro-mcp": {
      "type": "local",
      "command": ["npx", "-y", "ui-ux-pro-mcp", "--stdio"],
